# ==============================================================================
# Woka Reel Intelligence — Frontend Staging & Production Environment Variables
# ==============================================================================
# In Vercel, configure these under Project Settings > Environment Variables.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# DO NOT place backend secrets (SECRET_KEY, META_APP_SECRET) in frontend variables.

# Target FastAPI Backend API Base URL
# Staging example: https://woka-api-staging.onrender.com/api/v1
# Local dev example: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Deployment Environment Indicator ("staging", "production", or "development")
NEXT_PUBLIC_APP_ENV=development

# Optional Public Monitoring / Analytics Keys
# NEXT_PUBLIC_SENTRY_DSN=
