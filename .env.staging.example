# WOKA STAGING ENVIRONMENT CONFIGURATION TEMPLATE
ENVIRONMENT=staging
DEBUG=False
PROJECT_NAME="Woka API (Staging)"
API_V1_STR=/api/v1

# Staging Cryptographic Secrets
SECRET_KEY=generate-random-staging-jwt-secret-key-32-chars-min
TOKEN_ENCRYPTION_KEY=generate-32-byte-fernet-key-base64
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Staging PostgreSQL Database
DATABASE_URL=postgresql+psycopg2://woka_staging:staging_pass_woka_2026@postgres:5432/woka_staging
POSTGRES_USER=woka_staging
POSTGRES_PASSWORD=staging_pass_woka_2026
POSTGRES_DB=woka_staging

# Staging Meta Developer App Credentials (Controlled Test App)
META_APP_ID=staging_meta_app_id
META_APP_SECRET=staging_meta_secret
META_VERIFY_TOKEN=woka_staging_webhook_verify_token_2026
META_REDIRECT_URI=https://staging.woka.local:8443/dashboard/instagram/callback

# Allowed CORS Origins
CORS_ORIGINS=["https://staging.woka.local:8443", "https://localhost:8443", "http://localhost:3000"]
NEXT_PUBLIC_API_URL=https://staging.woka.local:8443/api/v1
