# WOKA ENVIRONMENT CONFIGURATION TEMPLATE
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Woka API"
API_V1_STR=/api/v1

# Cryptographic Keys (Generate random secrets for production)
SECRET_KEY=change-this-to-a-secure-random-64-character-string
TOKEN_ENCRYPTION_KEY=N0NlbmRfdG9rZW5fZW5jcnlwdGlvbl9zdGFnaW5nOTk=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Connection (SQLite for dev, PostgreSQL for staging/prod)
DATABASE_URL=sqlite:///./woka.db

# Official Meta Instagram Application
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-custom-webhook-verify-token
META_REDIRECT_URI=http://localhost:3000/dashboard/instagram/callback

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Optional AI Provider
OPENAI_API_KEY=
